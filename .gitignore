# build artifacts
/bin/
*.exe

# the gate's default durable feed directory (INTENT_DATA_DIR, default ./data):
# a reader who boots the gate directly rather than through the quickstart
# drops an event log here, and it is not ours to commit.
/data/

# release kits (assembled by scripts/release.sh)
/dist/

# scorer (Python service)
core/scorer/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
